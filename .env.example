# Frontend
NEXT_PUBLIC_BASE_URL=http://localhost:3005
NEXT_PUBLIC_API_URL=http://localhost:8005
INTERNAL_API_URL=http://localhost:8005
CORS_ORIGINS=http://localhost:3005

# Backend / MySQL
MYSQL_DATABASE=printstudios
MYSQL_ROOT_PASSWORD=pstudiosdb
DATABASE_URL=mysql+pymysql://root:pstudiosdb@localhost:3307/printstudios

# Auth placeholder for future admin API
JWT_SECRET=change-me

# Email transaccional
# mock deja los correos en cola MySQL; smtp o resend intentan envio real.
EMAIL_SEND_ENABLED=false
EMAIL_PROVIDER=mock
EMAIL_FROM=PrintStudios <cursos@printstudios.cl>

# SMTP ejemplo: Gmail Workspace, Zoho, Mailgun SMTP, SendGrid SMTP, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Resend API opcional
RESEND_API_KEY=

# Optional future commerce integrations
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
